# OpenAI credentials for Accessible Reader
#
# Copy to `.env` in the repo root (or to
# ~/Library/Application Support/AccessibleReader/.env):
#   cp .env.example .env
#
# Text-to-speech uses OpenAI’s Audio Speech API (/v1/audio/speech).

OPENAI_API_KEY=sk-your-key-here

# Optional TTS defaults
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
